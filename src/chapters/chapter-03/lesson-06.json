        "hi": "Ek fraction ka numerator denominator se 3 kam hai. Agar dono mein 2 add karein to fraction 1/2 ban jaata hai. Fraction nikaalo.",
        "en": "A fraction's numerator is 3 less than its denominator. Adding 2 to both makes the fraction 1/2. Find the fraction."
      },
      "steps": [
        {
          "hi": "Numerator=x, Denominator=y maano: x = y − 3",
          "en": "Let Numerator=x, Denominator=y: x = y − 3"
        },
        {
          "hi": "(x+2)/(y+2) = 1/2 → 2(x+2) = y+2 → 2x − y = −2",
          "en": "(x+2)/(y+2) = 1/2 → 2(x+2) = y+2 → 2x − y = −2"
        },
        {
          "hi": "x = y−3 substitute karo: 2(y−3) − y = −2 → y = 4",
          "en": "Substitute x = y−3: 2(y−3) − y = −2 → y = 4"
        },
        {
          "hi": "x = 1, Fraction = 1/4",
          "en": "x = 1, Fraction = 1/4"
        }
      ]
    }
