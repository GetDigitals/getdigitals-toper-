  "flashcards": [
    {
      "front": {
        "hi": "AP kya hai?",
        "en": "What is an AP?"
      },
      "back": {
        "hi": "Ek sequence jisme consecutive terms ka difference hamesha same (d) hota hai",
        "en": "A sequence where the difference between consecutive terms is always the same (d)"
      }
    },
    {
      "front": {
        "hi": "nth term formula?",
        "en": "nth term formula?"
      },
      "back": {
        "hi": "aₙ = a + (n-1)d",
        "en": "aₙ = a + (n-1)d"
      }
    },
    {
      "front": {
        "hi": "Sum formula (a,d given)?",
        "en": "Sum formula (a,d given)?"
      },
      "back": {
        "hi": "Sₙ = n/2[2a+(n-1)d]",
        "en": "Sₙ = n/2[2a+(n-1)d]"
      }
    },
    {
      "front": {
        "hi": "Sum formula (a,l given)?",
        "en": "Sum formula (a,l given)?"
      },
      "back": {
        "hi": "Sₙ = n/2(a+l)",
        "en": "Sₙ = n/2(a+l)"
      }
    },
    {
      "front": {
        "hi": "End se kth term?",
        "en": "kth term from the end?"
      },
      "back": {
        "hi": "l - (k-1)d",
        "en": "l - (k-1)d"
      }
    },
    {
      "front": {
        "hi": "Sum se nth term?",
        "en": "nth term from sum?"
      },
      "back": {
        "hi": "aₙ = Sₙ - Sₙ₋₁",
        "en": "aₙ = Sₙ - Sₙ₋₁"
      }
    },
    {
      "front": {
        "hi": "Pehle n odd numbers ka sum?",
        "en": "Sum of first n odd numbers?"
      },
      "back": {
        "hi": "n²",
        "en": "n²"
      }
    },
    {
      "front": {
        "hi": "Pehle n natural numbers ka sum?",
        "en": "Sum of first n natural numbers?"
      },
      "back": {
        "hi": "n(n+1)/2",
        "en": "n(n+1)/2"
      }
    }
  ],
