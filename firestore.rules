rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Every student can only read their OWN document — never anyone else's.
      allow read: if request.auth != null && request.auth.uid == userId;

      // On registration, paymentStatus must start as 'pending' — a student
      // cannot create their own account already marked 'approved'.
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.paymentStatus == 'pending';

      // On any update (device rebind, lastLoginAt, referral reward claims,
      // etc.), paymentStatus must stay UNCHANGED. This is what actually
      // blocks free access — a student cannot self-approve their own
      // payment by editing client-side data. Only Ashok, editing directly
      // in the Firebase console (which uses admin privileges and bypasses
      // these rules), can flip it to 'approved'.
      //
      // Note: rewardUnlockChapterId/rewardUnlockExpiresAt/
      // rewardClaimedForCount (Refer & Earn's 2-referrals-for-a-7-day-
      // chapter-unlock reward) are NOT cross-checked here against the
      // student's actual referral count — Firestore rules can't do that
      // kind of cross-collection validation without a Cloud Function. This
      // app has no backend, so that reward is an accepted, low-stakes,
      // client-side-trust feature (same trust model as the payment
      // approval itself and the soft single-device lock).
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.paymentStatus == resource.data.paymentStatus;
    }

    // referralCodes/{code} — a tiny lookup table mapping a short code to
    // the uid that owns it, so a new signup can resolve a friend's link
    // (?ref=CODE) into who referred them.
    match /referralCodes/{code} {
      // Any signed-in student can look up a code (needed to resolve a
      // friend's referral link before they've registered anything else).
      allow read: if request.auth != null;

      // A student may only ever claim the code entry that points to
      // THEIR OWN uid, and only once — a code, once claimed, is immutable.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // referrals/{autoId} — an append-only log of who referred whom.
    match /referrals/{referralId} {
      // A student can see referrals where they're the referrer (their own
      // Refer & Earn count) or the one who was referred.
      allow read: if request.auth != null
                  && (resource.data.referrerUid == request.auth.uid
                      || resource.data.referredUid == request.auth.uid);

      // You may only log a referral for YOURSELF being the one referred —
      // this is what stops anyone from faking referrals for other people
      // or inflating someone else's count.
      allow create: if request.auth != null
                    && request.resource.data.referredUid == request.auth.uid
                    && request.resource.data.referrerUid != request.auth.uid;
      allow update, delete: if false;
    }
  }
}
