rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every student can only read/write their OWN user document —
    // never anyone else's. This is what actually secures the device-lock
    // data (nobody can edit their own deviceId to spoof a new device).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
